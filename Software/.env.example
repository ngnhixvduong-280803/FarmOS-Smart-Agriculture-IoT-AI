# ========================================
# FarmOS Environment Variables (Example Template)
# Copy this file to .env before running the system: cp .env.example .env
# ========================================

# --- General System ---
# Canonical public origins. Values are origins only: no trailing slash and no
# /api/v1 path. The config checker derives simulator telemetry from FARMOS_API_URL.
FARMOS_WEB_URL=https://farmos.example.com
FARMOS_API_URL=https://api.farmos.example.com
# The backend image packages this immutable metadata file at this path. Set
# both values only when an approved read-only mount replaces it in production.
# FARMOS_FLASH_LAYOUT_PATH=/opt/farmos/firmware/flash_layout.json
# FARMOS_FLASH_LAYOUT_DIR=/opt/farmos/firmware
# Deprecated compatibility alias; remove after all deployments migrate.
DOMAIN=https://farmos.example.com
# Host port exposed by the frontend container.
PUBLIC_PORT=8080
# Internal backend port; must stay aligned with frontend/nginx.conf.
PORT=3000
NODE_ENV=production

# Cloudflare managed Tunnel token. Obtain it from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_your_tunnel_token
# Pin this to a tested Cloudflared version before deploying, never use :latest in production.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace_with_tested_version

# --- Database (Supabase PostgreSQL) ---
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only / Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Security & Auth ---
# Used only when explicitly enabling temporary legacy password auth. Generate at
# least 32 random bytes; this must never be committed or reused across environments.
JWT_SECRET=replace_with_a_64_character_random_secret
JWT_ISSUER=farmos-api
JWT_AUDIENCE=farmos-web
ALLOW_LEGACY_PASSWORD_AUTH=false
# Keep QR v3 as the only production onboarding path. Set true only for an
# explicitly approved legacy-v2 migration environment.
ENABLE_LEGACY_PROVISIONING=false
# Legacy MQTT telemetry/status/ACK is disabled by default; the current
# physical firmware uses device-scoped HTTPS ingestion.
ENABLE_LEGACY_MQTT_INGEST=false
# Do not enable until a released Gateway has verified relay, hard interlock,
# flow feedback, command receipt and emergency-stop behavior on real hardware.
IRRIGATION_CONTROL_ENABLED=false
# Node IDs with independently verified pump interlock and contactor feedback
PUMP_CONTROL_NODE_IDS=
# A device is displayed/treated Online only while a recent heartbeat exists.
NODE_ONLINE_TTL_SEC=120
# A tank interlock heartbeat older than this blocks irrigation fail-closed.
SAFETY_TANK_STATUS_TTL_SEC=120

# Required for direct HTTP telemetry/status/ACK fallback from a physical gateway.
# Generate with: openssl rand -base64 48
DEVICE_INGEST_TOKEN=replace_with_a_48_byte_random_device_ingest_token

# Board identity and firmware signing configuration. Keep all private material
# server-only. Generate unique values per environment; never commit real keys.
HARDWARE_BOARD_HMAC_SECRET=replace_with_at_least_32_random_bytes
FIRMWARE_MANIFEST_SIGNING_KEY=replace_with_manifest_signing_secret
FIRMWARE_MANIFEST_KEY_ID=farmos-manifest-v1
# EC P-256 PKCS#8 PEM; literal \n escapes are accepted in dotenv.
FIRMWARE_ENROLLMENT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_pkcs8_ec_p256_key\n-----END PRIVATE KEY-----\n"
FIRMWARE_ENROLLMENT_SIGNING_PUBLIC_KEY=replace_with_matching_spki_der_base64url_public_key
FIRMWARE_ENROLLMENT_KEY_ID=farmos-enrollment-v1
# Optional firmware alias for the canonical public key above. Leave unset to
# avoid duplication; if set, it must match FIRMWARE_ENROLLMENT_SIGNING_PUBLIC_KEY.
# The generator emits the matching value into an ignored sdkconfig overlay for
# both Node and Gateway production builds. Never copy the private key above.
# FIRMWARE_ENROLLMENT_SERVER_PUBLIC_KEY="replace_with_p256_spki_der_base64url"
# Optional public API origin for tooling. Firmware does not compile this URL:
# mobile provisioning sends the runtime API URL over the authenticated BLE
# channel, so changing a server endpoint never requires a new firmware image.
# FARMOS_API_URL="https://api.farmos.example.com"


# Manufacturing QR v3. Keep the Ed25519 private key in the server-only env
# file; it must never be copied into a QR payload, browser bundle, or station
# log. PEM with literal \n escapes is accepted. Production refuses to issue
# labels when the key is absent.
MANUFACTURING_QR_ISSUER=farmos
MANUFACTURING_QR_KEY_ID=prod-2026-01
MANUFACTURING_QR_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_pkcs8_ed25519_key\n-----END PRIVATE KEY-----"
# Optional JSON object for verification during key rotation: {"old-kid":"PEM..."}
MANUFACTURING_QR_PUBLIC_KEYS="{}"
# QR_ISSUER / QR_KEY_ID / QR_SIGNING_PRIVATE_KEY are accepted aliases.
# Optional scoped station credentials. Format: station-id:token,station-id-2:token
MANUFACTURING_STATION_TOKENS="station-01:replace_with_station_token"
# Alternative single-station form (do not set both forms for the same station):
# MANUFACTURING_STATION_ID=station-01
# MANUFACTURING_STATION_TOKEN=replace_with_station_token

# Optional local secure USB station references. Private files stay outside Git;
# paths are relative to the source checkout root, or absolute. These are not
# firmware compile-time secrets and are never uploaded to the backend.
# FARMOS_SECURE_BOOT_SIGNING_KEY_FILE="private/secure_boot_v2_rsa3072.pem"
# FARMOS_FLASH_ENCRYPTION_KEY_FILE="private/per_board_flash_xts128.bin"
# FARMOS_FACTORY_BOARD_MAC="aa:bb:cc:dd:ee:ff"
# FARMOS_FACTORY_IDENTITY_MANIFEST="private/public-binding.json"
# FARMOS_FACTORY_FLASH_PLAN="private/binding-plan.json"
# Optional per-MAC station registry (private JSON, never committed).
# FARMOS_FACTORY_BOARD_REGISTRY="private/board-registry.json"

# Supabase Auth Configuration
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
# Public OAuth client ID from Google Auth Platform > Clients > FarmOS Web.
VITE_GOOGLE_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"
# Public backend origin used by the React Native app. This is safe to ship.
MOBILE_API_BASE_URL="https://api.farmos.example.com"
# Optional: Google Maps / Places API Key for direct Google Places autocomplete. If omitted, FarmOS uses built-in smart Photon + OSM proximity engine.
VITE_GOOGLE_MAPS_API_KEY=""

# Admin Emails (comma-separated, automatically given ADMIN role)
ADMIN_EMAILS="admin@farmos.local,admin@gmail.com"

# --- MQTT Broker ---
MQTT_BROKER_URL=mqtt://mosquitto:1883
# The backend connects to the internal listener. Remote gateways use mqtts://<host>:8883.
MQTT_PUBLIC_PORT=8883
MQTT_USERNAME=farmos-backend
MQTT_PASSWORD=replace_with_a_unique_mqtt_password
MQTT_CONFIG_DIR=/opt/farmos/mosquitto
MQTT_CERTS_DIR=/opt/farmos/mosquitto/certs

# --- Gateway / Simulator Settings ---
# The simulator implements the same mTLS/outbox contract expected of ESP32.
# Never provision backend MQTT credentials or certificate private keys into Git.
GATEWAY_MQTT_BROKER_URL=mqtts://mqtt.farmos.example.com:8883
GATEWAY_MQTT_AUTH_MODE=mtls
GATEWAY_ID=GATEWAY_01
GATEWAY_MQTT_CA_CERT_FILE=./simulator/certs/gateway-ca.pem
GATEWAY_MQTT_CLIENT_CERT_FILE=./simulator/certs/GATEWAY_01-cert.pem
GATEWAY_MQTT_CLIENT_KEY_FILE=./simulator/certs/GATEWAY_01-key.pem
GATEWAY_OUTBOX_FILE=./simulator/.gateway-simulator-outbox.json
GATEWAY_OUTBOX_MAX_MESSAGES=500
GATEWAY_MQTT_RETRY_INITIAL_MS=1000
GATEWAY_MQTT_RETRY_MAX_MS=60000
FARM_ID=F01
# Deprecated compatibility alias. Use FARMOS_API_URL; the simulator appends
# /api/v1/telemetry from the canonical origin.
BACKEND_API_URL=https://api.farmos.example.com/api/v1/telemetry
SIMULATOR_PORT=4000
TELEMETRY_INTERVAL_SEC=15

# Offline application signing key path for tools/build_firmware.py (never commit the key).
# FARMOS_FIRMWARE_SIGNING_KEY_FILE=/secure/path/application-rsa3072.pem
