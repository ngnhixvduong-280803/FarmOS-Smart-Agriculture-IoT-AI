{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FarmOS Flasher",
  "version": "0.1.0",
  "identifier": "sbs.trendhub.farmos.desktop-flasher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "FarmOS Flasher", "width": 1360, "height": 900, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https:" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["farmos"] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "resources": ["resources/tools/**/*"] }
}
