# Device credentials for a dedicated SIM_ farm. Never use physical device tokens.
FARMOS_LAB_API_URL=https://your-farmos-cloud.example
FARMOS_LAB_GATEWAY_TOKENS={"SIM_GATEWAY_01":"replace-with-private-device-token"}
# dataset stores all context/labels separately, requires the additive backend migration.
FARMOS_LAB_CLOUD_MODE=dataset
