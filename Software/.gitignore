__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Flutter / Dart / Mobile
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
ios/Flutter/Generated.xcconfig
android/.gradle
android/app/build/

# PlatformIO / Firmware
.pio/
.pioenvs/
.piolibdeps/
.clangd/
